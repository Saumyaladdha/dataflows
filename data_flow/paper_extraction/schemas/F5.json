{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "F5 · one chapter's release-gate verdict (spec 14/F5)",
  "description": "What export_tables.gate() returns and what data/_release_log.jsonl records. `ok` is true only when EVERY condition passed; there is no override.",
  "type": "object",
  "required": ["chapter_id", "ok", "conditions"],
  "additionalProperties": true,
  "properties": {
    "chapter_id": {"type": "string", "pattern": "^[A-Z]{3}\\d{2}-CH\\d{2}$"},
    "ok": {"type": "boolean"},
    "audit_target": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "questions": {"type": "array", "items": {"type": "string", "pattern": "^Q-\\d{6}$"}},
    "signoff": {
      "type": ["object", "null"],
      "required": ["chapter_id", "released_at", "signed_by"],
      "additionalProperties": true,
      "properties": {
        "chapter_id": {"type": "string"},
        "released_at": {"type": "string", "minLength": 4},
        "signed_by": {"type": "string", "minLength": 1},
        "gold_score_snapshot": {"type": ["string", "null"]},
        "open_flags": {"type": ["string", "null"]}
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "requirement", "ok", "detail"],
        "additionalProperties": true,
        "properties": {
          "id": {"enum": ["queue_empty", "subtopic_list_approved", "change_log_rows_approved",
                          "audit_sample_meets_target", "signoff_row", "nothing_blocked"]},
          "requirement": {"type": "string", "minLength": 1},
          "ok": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
