{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/B2.json",
  "title": "B2 agent output (b2-boundary-finder)",
  "description": "Section 10/B2 'Agent output' line and the b2-boundary-finder agent file (Appendix B), including its worked examples (a question continuing from the previous column, and a genuine numbering gap -- a real 2023-paper finding -- that must be reported, never silently absorbed).",
  "oneOf": [
    {
      "type": "object",
      "required": ["page", "questions", "top_continues_from_previous", "note"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/definitions/question" }
        },
        "top_continues_from_previous": {
          "type": "object",
          "required": ["left", "right"],
          "additionalProperties": false,
          "properties": {
            "left": { "type": "boolean" },
            "right": { "type": "boolean" }
          }
        },
        "note": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": { "error": { "type": "string" } },
      "description": "Universal rule 8: if the input file is missing or broken, the agent writes only {\"error\": \"...\"}."
    }
  ],
  "definitions": {
    "question": {
      "type": "object",
      "required": ["qno", "parts"],
      "additionalProperties": false,
      "properties": {
        "qno": {
          "type": "integer",
          "minimum": 1,
          "description": "The printed question number, copied exactly -- never renumbered to close a gap."
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/part" }
        },
        "continues_on_next": {
          "type": "boolean",
          "description": "True when this question's last part continues on the next column/page."
        }
      }
    },
    "part": {
      "type": "object",
      "required": ["column", "bbox"],
      "additionalProperties": false,
      "properties": {
        "column": { "type": "string", "enum": ["left", "right", "full"] },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x0, y0, x1, y1] in image pixels."
        }
      }
    }
  }
}
