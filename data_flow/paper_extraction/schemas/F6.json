{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "F6 · gold-set score summary (spec 14/F6, targets from Section 1.1)",
  "type": "object",
  "required": ["per_criterion"],
  "additionalProperties": true,
  "properties": {
    "per_criterion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "target", "checked", "matched", "rate", "meets_target"],
        "additionalProperties": true,
        "properties": {
          "id": {"enum": ["text_exact", "answer_joined", "chapter", "subtopic", "quotes_found",
                          "evidence_passage", "repeats", "thinking"]},
          "name": {"type": "string"},
          "target": {"type": "number", "minimum": 0, "maximum": 1},
          "fields": {"type": "array", "items": {"type": "string"}},
          "checked": {"type": "integer", "minimum": 0},
          "matched": {"type": "integer", "minimum": 0},
          "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "meets_target": {"type": ["boolean", "null"]},
          "per_subject": {"type": "object"}
        }
      }
    },
    "per_step": {"type": "object"},
    "failures": {"type": ["array", "integer"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
